<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0">
<head><meta name="description" content="alpha from transparency (BLEND), alphaMode MASK with cutoff, alphaMode OPAQUE, solid=false giving doubleSided, unlit texture with alpha"/></head>
<Scene>
<NavigationInfo headlight="false"/>
<Viewpoint position="0 0 6"/>
<DirectionalLight direction="0 0 -1"/>
<Transform translation="-3 0 0"><Shape><Appearance><PhysicalMaterial baseColor="0.9 0.2 0.2" transparency="0.5"/></Appearance><Box size="1 1 1"/></Shape></Transform>
<Transform translation="-1 0 0"><Shape><Appearance alphaMode="MASK" alphaCutoff="0.3"><PhysicalMaterial baseColor="0.2 0.9 0.2"><ImageTexture containerField="baseTexture" url='"img/half-alpha.png"'/></PhysicalMaterial></Appearance><Box size="1 1 1"/></Shape></Transform>
<Transform translation="1 0 0"><Shape><Appearance alphaMode="OPAQUE"><PhysicalMaterial baseColor="0.2 0.2 0.9" transparency="0.5"/></Appearance><Box size="1 1 1" solid="false"/></Shape></Transform>
<Transform translation="3 0 0"><Shape><Appearance alphaMode="BLEND"><UnlitMaterial emissiveColor="1 1 0" transparency="0.25"><ImageTexture containerField="emissiveTexture" url='"img/half-alpha.png"'/></UnlitMaterial></Appearance><Box size="1 1 1"/></Shape></Transform>
</Scene>
</X3D>
