<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0">
<head><meta name="description" content="PhysicalMaterial normalTexture on an IndexedFaceSet (Castle writes no tangents for it): the glb must carry TANGENT so the validator has no MESH_PRIMITIVE_GENERATED_TANGENT_SPACE warning"/></head>
<Scene>
<NavigationInfo headlight="false"/>
<Viewpoint position="0 0 6"/>
<DirectionalLight direction="0 0 -1"/>
<Shape>
 <Appearance>
  <PhysicalMaterial baseColor="0.8 0.8 0.8" metallic="0" roughness="0.5">
   <ImageTexture containerField="normalTexture" url='"img/normal.png"'/>
  </PhysicalMaterial>
 </Appearance>
 <IndexedFaceSet coordIndex="0 1 2 3 -1" solid="false">
 <Coordinate point="-1 -1 0, 1 -1 0, 1 1 0, -1 1 0"/>
  <TextureCoordinate point="0 0, 1 0, 1 1, 0 1"/>
 </IndexedFaceSet>
</Shape>
</Scene>
</X3D>
